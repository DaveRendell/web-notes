{
  "name": "web-notes-repo",
  "private": true,
  "scripts": {
    "install:all": "npm ci --prefix web && npm ci --prefix android",
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web --",
    "generate:pwa-icons": "npm run generate:pwa-icons --prefix web",
    "preview": "npm run preview --prefix web --",
    "lint": "npm run lint --prefix web",
    "test": "npm run test --prefix web && npm run test --prefix android",
    "test:browser": "npm run test:browser --prefix web --",
    "test:browser:ui": "npm run test:browser:ui --prefix web --",
    "check:web": "npm run check --prefix web",
    "check:android": "npm run check --prefix android",
    "check": "npm run check:web && npm run check:android",
    "android": "npm run android --prefix android",
    "android:bundle": "npm run bundle --prefix android"
  }
}
